(executable
 (name main)
 (public_name gitter)
 (libraries async bonsai bonsai_term core core_unix
   core_unix.command_unix gitter)
 (link_flags (:include link_flags.sexp))
 (preprocess
  (pps ppx_jane bonsai.ppx_bonsai)))

; Link flags depend on the environment: inside the nix shell
; $GITTER_STATIC_LIB_DIR points at a directory of ONLY .a archives
; (libvterm, sqlite3) that must come FIRST on the search path so both
; link statically — the released binary may not reference /nix/store.
; Both linkers prefer the shared library over the archive WITHIN a
; directory, so an archive-only dir first pins them; the drop-unused-
; libraries flag is spelled -dead_strip_dylibs on macOS and --as-needed
; on Linux. -Wl,-w silences the SDK-version ld warning flood and is
; macOS-only: GNU ld has no -w and rejects it outright.
(rule
 (targets link_flags.sexp)
 (deps (env_var GITTER_STATIC_LIB_DIR))
 (action
  (with-stdout-to
   %{targets}
   (run
    bash
    -c
    "case \"$(uname -s)\" in Darwin) if [ -n \"${GITTER_STATIC_LIB_DIR:-}\" ]; then printf '(-ccopt -L%s -cclib -Wl,-dead_strip_dylibs -cclib -Wl,-w)' \"$GITTER_STATIC_LIB_DIR\"; else printf '(-cclib -Wl,-w)'; fi ;; Linux) if [ -n \"${GITTER_STATIC_LIB_DIR:-}\" ]; then printf '(-ccopt -L%s -cclib -Wl,--as-needed)' \"$GITTER_STATIC_LIB_DIR\"; else printf '()'; fi ;; *) printf '()' ;; esac"))))

; Version stamp: releases build with GITTER_VERSION=<tag> in the
; environment; anything else reports "dev".
(rule
 (targets version.ml)
 (deps (env_var GITTER_VERSION))
 (action
  (with-stdout-to
   %{targets}
   (run bash -c "printf 'let version = \"%s\"' \"${GITTER_VERSION:-dev}\""))))
