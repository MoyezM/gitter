"""Typed ingest failures, so a bad line names itself."""


class IngestError(Exception):
    """Base for anything that goes wrong parsing an event."""


class MalformedLine(IngestError):
    def __init__(self, raw: str):
        super().__init__(f"malformed event line: {raw!r}")
        self.raw = raw


class BadTimestamp(IngestError):
    def __init__(self, raw: str, at: str):
        super().__init__(f"bad timestamp {at!r} in {raw!r}")
        self.raw = raw
        self.at = at
EOF
git -C "$dest" add -A
