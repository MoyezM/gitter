'''    pub fn mean(&self, at: u64) -> Option<f64> {
        let key = at - (at % self.width);
        let values = self.buckets.get(&key)?;
        Some(values.iter().sum::<f64>() / values.len() as f64)
    }

    /// Drop every bucket that closed before `cutoff`.
    pub fn evict(&mut self, cutoff: u64) -> usize {
        let keep = self.buckets.split_off(&cutoff);
        let dropped = self.buckets.len();
        self.buckets = keep;
        dropped
    }

    pub fn len(&self) -> usize {
        self.buckets.len()
    }''')
open(p, 'w').write(s)
