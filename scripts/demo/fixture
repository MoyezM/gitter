cat > "$dest/src/cli.py" <<'EOF'
"""Command line entry point: read events, print rolled-up windows."""

import argparse
import sys

from .ingest import read_all
from .rollup import rollup


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="telemetry")
    parser.add_argument("--window", type=int, default=60, help="window width, seconds")
    parser.add_argument("--quiet", action="store_true")
    args = parser.parse_args(argv)

    windows = rollup(read_all(sys.stdin))
    if not args.quiet:
        for (name, start), mean in sorted(windows.items()):
            print(f"{start}\t{name}\t{mean:.3f}")
    return 0
EOF
