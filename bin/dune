(executable
 (name main)
 (public_name gitter)
 (libraries async bonsai bonsai_term core core_unix
   core_unix.command_unix gitter)
 (link_flags (:include link_flags.sexp))
 (preprocess
  (pps ppx_jane bonsai.ppx_bonsai)))

; Link flags vary by platform and by whether we are inside the nix dev
; shell, so they are computed rather than written down. scripts/link-flags
; explains each flag; test/dune and bench/dune copy the sexp this produces
; so everything links the same way.
(rule
 (targets link_flags.sexp)
 (deps (env_var GITTER_STATIC_LIB_DIR))
 (action
  (with-stdout-to
   %{targets}
   (run bash %{dep:../scripts/link-flags}))))

; Version stamp: releases build with GITTER_VERSION=<tag> in the
; environment; anything else reports "dev".
(rule
 (targets version.ml)
 (deps (env_var GITTER_VERSION))
 (action
  (with-stdout-to
   %{targets}
   (run bash -c "printf 'let version = \"%s\"' \"${GITTER_VERSION:-dev}\""))))
